{
  "name": "cpda-portal-server",
  "version": "1.0.0",
  "description": "CPDA & Budget Fund Management Portal - API (Node.js + Express + PostgreSQL)",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/bootstrap.js && node src/index.js",
    "dev": "node src/bootstrap.js && node --watch src/index.js",
    "db:init": "node db/init.js",
    "db:seed": "node db/seed.js",
    "db:reset": "node db/init.js --reset && node db/seed.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.14",
    "pdfkit": "^0.15.0",
    "pg": "^8.12.0"
  }
}
