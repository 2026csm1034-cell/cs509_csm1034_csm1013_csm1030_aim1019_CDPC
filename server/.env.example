# Copy to .env and edit
PORT=4000
DATABASE_URL=postgres://cpda:cpda123@localhost:5432/cpda_portal
JWT_SECRET=change-this-secret
# OAuth 2.0 Web application client ID from Google Cloud Console
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# Optional: real email notifications (otherwise emails are skipped, in-app notifications still work)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=cpda-portal@example.com
# Optional: only allow Google accounts from this domain, e.g. iitrpr.ac.in
# GOOGLE_ALLOWED_DOMAIN=iitrpr.ac.in
